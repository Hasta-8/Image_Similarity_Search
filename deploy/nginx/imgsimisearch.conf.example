# Example same-origin HTTP routing. Replace the hostname and build root.
# TLS termination, DNS, firewall rules, and host-specific limits are not configured.
upstream imgsimisearch_backend {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    server_name __PUBLIC_HOSTNAME__;
    root "__FRONTEND_BUILD_DIR__";
    index index.html;

    # Keep this equal to the backend IMGSIMI_MAX_UPLOAD_BYTES default (16 MiB).
    # The application enforces the same bound, so either layer rejects oversize
    # uploads with 413 and the two limits cannot drift apart silently.
    client_max_body_size 16m;
    client_body_timeout 30s;

    location = /search-image {
        proxy_pass http://imgsimisearch_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 120s;
        proxy_read_timeout 180s;
        proxy_request_buffering off;
    }

    location = /health {
        proxy_pass http://imgsimisearch_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    location = /ready {
        proxy_pass http://imgsimisearch_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    location ^~ /images/ {
        proxy_pass http://imgsimisearch_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
