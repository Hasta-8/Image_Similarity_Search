{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImgSimiSearch human-labeled retrieval query",
  "type": "object",
  "required": ["query_path", "relevant_paths"],
  "additionalProperties": false,
  "properties": {
    "query_path": {
      "type": "string",
      "minLength": 1,
      "description": "Existing dataset-relative POSIX image path used as the query."
    },
    "relevant_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Human-labeled relevant dataset-relative image paths; omit the query itself."
    }
  }
}
